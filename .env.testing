APP_NAME=Laravel
APP_ENV=testing
APP_KEY=base64:9YIdmPvak5J1QPCn4p9A12f0eWqOE+xDUMzfe/nYRTI=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Тесты идут в отдельную базу PostgreSQL (MySQL из проекта убрали вместе с ботом): база water_test должна
# существовать — createdb water_test. Порт и пароль своей копии можно передать переменными окружения при запуске:
# DB_PORT=55432 DB_PASSWORD=secret php artisan test
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=water_test
DB_USERNAME=postgres
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=array
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=array

MAIL_MAILER=array

# Пустой токен: пакет php-telegram-bot при пустом токене не подключается к MySQL на старте.
TELEGRAM_API_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_API_URL=
TELEGRAM_ADMINS=

# Заглушки: сервис перевода проверяет конфиг уже в конструкторе,
# а тестам он не нужен — запросы в сеть из тестов не уходят.
LINGVANEX_TRANSLATE_TOKEN=testing
LINGVANEX_TRANSLATE_URI=https://translate.invalid/
